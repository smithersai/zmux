          "type": "cards",
          "title": "How a change lands",
          "cards": [
            {
              "title": "Reproduce on a real PTY",
              "text": "Run the failing unit, integration, or fuzz target against a real UNIX socket and PTY before patching."
            },
            {
              "title": "Run untrusted checks freely",
              "text": "Anyone can run smthrs ci and uphill locally with read-only cache hits. Untrusted runs never write cache or skip gates."
            },
            {
              "title": "Open one focused change",
              "text": "Use the Smithers Cloud MCP server to file issues, draft TODOs, and link stacked changesets with credit preserved."
            },
            {
              "title": "Trusted gate and auto release",
              "text": "A maintainer approves and runs trusted gates. Merging to GitHub publishes binaries, docs, llms.txt, and the audit report."
