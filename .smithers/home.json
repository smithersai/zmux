        {
          "type": "code",
          "title": "Quick start over UNIX socket",
          "language": "sh",
          "code": "zmuxd --socket /tmp/zmux.sock &\nprintf '{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"daemon.ping\"}\\n' | nc -U /tmp/zmux.sock\nzmux-connect --socket /tmp/zmux.sock work --spawn-daemon"
        },
        {
          "type": "code",
          "title": "Embed in Zig",
          "file": "src/main.zig",
          "language": "zig",
          "code": "const zmux = @import(\"zmux\");\n\nvar srv = try zmux.Server.init(allocator, io, \"/tmp/zmux.sock\", 60);\ndefer srv.deinit();\ntry srv.run();"
        },
        {
          "type": "cards",
          "title": "Why zmux",
          "cards": [
            {
              "title": "Structured JSON-RPC over UNIX socket",
              "text": "Every call returns typed JSON with explicit error kinds. No format strings or screen-scraping."
            },
            {
              "title": "Multi-client PTY sharing",
              "text": "Native apps, web terminals, and headless agents attach to the same daemon-owned pane together."
            },
            {
              "title": "Bounded scrollback replay",
              "text": "Ring-buffered output tracks monotonic offsets and generations so reattaching clients never miss bytes."
            },
            {
              "title": "Owner-only socket security",
              "text": "Private 0700 directories, same-UID peer credential checks, and startup locking protect every daemon."
            },
            {
              "title": "Incremental Smithers builds",
              "text": "Per-module Zig dependency closures cache tests, fuzz runs, and benchmarks in the shared cloud object store."
            },
            {
              "title": "Lighthouse backpressure",
              "text": "Continuous Uphill audits score footprint, TigerStyle, correctness, test coverage, and docs on every change."
            }
          ]
        },
