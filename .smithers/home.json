    {
      "audience": "everyone",
      "blocks": [
        {
          "type": "hero",
          "title": "zmux",
          "tagline": "tmux-style PTY session multiplexer in Zig with a structured JSON-RPC UNIX socket protocol.",
          "text": "A long-lived daemon owns sessions, windows, panes, and PTYs so desktop apps, web terminals, and agents attach and replay scrollback without shelling out to tmux.",
          "install": "gh repo clone smithersai/zmux",
          "actions": [
            {
              "label": "Documentation",
              "url": "https://smithersai.github.io/zmux/"
            },
            {
              "label": "Lighthouse audit",
              "url": "https://smithersai.github.io/zmux/audit/"
            },
            {
              "label": "Releases",
              "url": "https://github.com/smithersai/zmux/releases"
            }
          ],
          "announcement": {
            "label": "v0.4.0: Hardened JSON-RPC protocol, bounded replay, and Zig 0.17.1",
            "url": "https://github.com/smithersai/zmux/releases/tag/v0.4.0"
          }
        },
        {
          "type": "stats",
          "stats": [
            {
              "value": "MIT",
